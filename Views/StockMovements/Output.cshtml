@model EasyStock.Models.ViewModels.StockMovementFormViewModel
@{
    ViewData["Title"] = ViewBag.MovementTitle ?? "Sortie de stock";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="mb-2">@ViewBag.MovementTitle</h1>
                <p class="text-muted">@ViewBag.MovementDescription</p>

                <form asp-action="Output" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="col-md-12">
                        <label asp-for="ArticleId" class="form-label"></label>
                        <select asp-for="ArticleId" asp-items="ViewBag.ArticleId" class="form-select">
                            <option value="">Sélectionner un équipement</option>
                        </select>
                        <span asp-validation-for="ArticleId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Quantite" class="form-label"></label>
                        <input asp-for="Quantite" class="form-control" />
                        <span asp-validation-for="Quantite" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="ReferenceExterne" class="form-label"></label>
                        <input asp-for="ReferenceExterne" class="form-control" placeholder="Référence de la sortie" />
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Motif" class="form-label"></label>
                        <textarea asp-for="Motif" class="form-control" rows="4" placeholder="Justification de la sortie"></textarea>
                    </div>
                    <div class="col-12 d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">@ViewBag.SubmitLabel</button>
                        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
