@model IEnumerable<EasyStock.Models.Category>
@{
    ViewData["Title"] = "Catégories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Catégories</h1>
    <a class="btn btn-primary" asp-action="Create">Ajouter une catégorie</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CategoryId">Modifier</a> |
                <a asp-action="Delete" asp-route-id="@item.CategoryId">Supprimer</a>
            </td>
        </tr>
    }
    </tbody>
</table>


