@model EasyStock.Models.User
@{
    ViewData["Title"] = "Détails utilisateur";
}

<h1>Détails utilisateur</h1>

<div class="card p-4 shadow-sm border-0">
    <dl class="row mb-0">
        <dt class="col-sm-3">Nom d'utilisateur</dt>
        <dd class="col-sm-9">@Model.Username</dd>
        <dt class="col-sm-3">Courriel</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Rôle</dt>
        <dd class="col-sm-9">@Model.Role?.RoleName</dd>
        <dt class="col-sm-3">Créé par</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>
        <dt class="col-sm-3">Créé le</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        <dt class="col-sm-3">Mis à jour le</dt>
        <dd class="col-sm-9">@Model.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary">Modifier</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour</a>
</div>
