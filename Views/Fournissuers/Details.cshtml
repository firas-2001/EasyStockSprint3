@model EasyStock.Models.Fournisseur
@{
    ViewData["Title"] = "Détails fournisseur";
}

<h1>Détails fournisseur</h1>
<dl class="row">
    <dt class="col-sm-2">Nom</dt><dd class="col-sm-10">@Model.Nom</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.ContactEmail</dd>
    <dt class="col-sm-2">Téléphone</dt><dd class="col-sm-10">@Model.PhoneNumber</dd>
    <dt class="col-sm-2">Adresse</dt><dd class="col-sm-10">@Model.Address</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Retour</a>


