@model EasyStock.Models.Article
@{
    ViewData["Title"] = "Ajouter un équipement";
}

<h1>Ajouter un équipement</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="FournisseurId" class="form-label"></label>
        <select asp-for="FournisseurId" asp-items="ViewBag.FournisseurId" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="NombreArticleActuel" class="form-label"></label>
        <input asp-for="NombreArticleActuel" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="NombreArticleMinimum" class="form-label"></label>
        <input asp-for="NombreArticleMinimum" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}




